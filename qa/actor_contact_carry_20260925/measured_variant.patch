diff --git a/scripts/actors/operator_actor.gd b/scripts/actors/operator_actor.gd
index 267038702..b91ea2aec 100644
--- a/scripts/actors/operator_actor.gd
+++ b/scripts/actors/operator_actor.gd
@@ -71,6 +71,10 @@ var _scatter_cycle_left := 0.0
 
 func _ready() -> void:
     add_to_group("operators")
+    # Top-down: no body is a moving floor. In the default grounded mode a robot touched on
+    # its north side counts as floor, and move_and_slide would carry the operator with it.
+    platform_floor_layers = 0
+    platform_on_leave = PLATFORM_ON_LEAVE_DO_NOTHING
     _visual = $VisualRoot as OperatorVisual
     ammo = magazine_size
     health = max_health
